# Copy to /opt/dsh/env on the host. This file is not loaded from the git tree.
# Official `dsh web` still binds 127.0.0.1; nginx and the tunnel publish it.

# nginx :80 server_name values (space-separated). The public IP is required for
# browser access as http://IP/ because the cloud security group forwards :80.
DSH_SERVER_NAME="dsh.118.145.156.15.sslip.io 118.145.156.15"

# Host values the official /api fence accepts. Port 80 omits :port; other ports include it.
DSH_PUBLIC_HOST=118.145.156.15
DSH_EXTRA_HOSTS=dsh.118.145.156.15.sslip.io,118.145.156.15:13080

# Loopback port for the official CLI. Do not publish this port on 0.0.0.0.
DSH_BIND_PORT=3080

# nginx listen port on all interfaces. Use when the security group forwards it; :80 is the public path.
# Point cloudflared/Caddy at this port (127.0.0.1:13080), not at DSH_BIND_PORT, so /api Host rewrite applies.
DSH_PUBLISH_PORT=13080

# npm dist-tag or exact version of the official CLI. Overlay never builds packages/.
DSH_NPM_SPEC=@deepseek-ai/dsh@0.1.0-rc.6

# Optional. Leave empty and set the key in the Web UI under Settings → Models.
# DEEPSEEK_API_KEY=

# Keep session telemetry local unless you explicitly opt in.
DSH_TELEMETRY_DISABLED=1
